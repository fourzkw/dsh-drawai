          <mxGeometry x="0" y="300" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="进入首页" style="fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="0" y="450" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="rounded=0;html=1;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;endArrow=classic;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="rounded=0;html=1;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;endArrow=classic;" edge="1" parent="1" source="n2" target="n3">
          <mxGeometry relative="1" as="geometry" />
