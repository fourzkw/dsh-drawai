# 本机自测用的 @deepseek-ai/* junction，机器相关，不要提交
node_modules/

# 本机 npm 缓存在 ~/.npm 只读时用的本地目录（见 README 的「开发」一节）
.npm-cache/

# 本机临时：浏览器配置、ACL 恢复、矢量化自检素材
.edge-tmp/
.acl-recovery/
.vectorize/
.selfcheck.mjs

# 本机画布 / 自检素材（不进仓库；根目录只留 demo.drawio）
_local/
.drawai-cache/

# 自检输出、下载素材和临时工具（历史目录；新素材统一放 _local/）
/artifacts/
/downloads/
/.tools/
/.tmp/
/.tmp-video/

# 本地 drawio webapp junction（见 README 开发一节）
vendor/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
*.log
*.bak

# 画布文件：仓库里只留 demo.drawio（示例图，画布默认读它）
# 其余 *.drawio 都是各人工作区里的图，不进仓库
*.drawio
!demo.drawio
!docs/**/*.drawio

# 视频旁路媒体包（<画布>.media/，逐帧 SVG 由画布侧生成，体积大，不进仓库）
*.media/

# 动效视频工程（含 .out 渲染产物、assets 素材，体积大，本机产物）
.drawai-motion/
# 动效/音频临时目录
.audio-src/
.voice-probe/
.acl-report/
out/
reference-media/
# 画布文件（*.drawio 已忽略，*.drawai 同理）
*.drawai

# 上游公开素材（纹理 / 乐器采样）：由 tools/vendor-motion-media.mjs 按固定 commit
# 下载并校验 Git blob 哈希，约 66MB；lib 下同目录是构建副本。发布前跑一次即可。
src/motion/media-library/
lib/motion/media-library/

# 随发布包提供的中英文字体（约 135MB，第三方，授权见 LICENSE）。
# 本地保留即可；重新取回后 `npm run build` 会同步到 lib。
src/motion/fonts/
lib/motion/fonts/

# 画布备份（.bak-flat / .bak-png / … ：体积大且是一次性回滚点）
*.bak-*
